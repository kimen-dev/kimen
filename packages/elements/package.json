{
  "name": "@kimen/elements",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kimen web components (ki-*). Standards-first Stencil components, tokens-only styling, agent-legible by contract.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimen-dev/kimen.git",
    "directory": "packages/elements"
  },
  "files": [
    "dist",
    "icons",
    "loader",
    "generated/custom-elements.json",
    "llms.txt",
    "llms-full.txt",
    "llms",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build-surfaces.mjs --prepare-package-summary && node scripts/generate-icons.mjs && stencil build && node scripts/normalize-react-wrappers.mjs && node scripts/normalize-angular-proxies.mjs && node scripts/sync-components.mjs && node scripts/normalize-declaration-specifiers.mjs && node scripts/build-surfaces.mjs",
    "test": "node --test scripts/icon-modules.test.mjs && vitest run && vitest run --config vitest.node.config.ts",
    "test-browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.browser.config.ts",
    "size": "node scripts/run-size-limit.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "nx": {
    "tags": [
      "scope:elements"
    ],
    "implicitDependencies": [
      "@kimen/tokens"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          "!{projectRoot}/generated/**",
          "!{projectRoot}/icons/**",
          "!{projectRoot}/loader/**",
          "!{projectRoot}/llms.txt",
          "!{projectRoot}/llms-full.txt",
          "!{projectRoot}/llms/**",
          "!{projectRoot}/src/components.d.ts",
          "{workspaceRoot}/docs/genui-surfaces.json",
          "{workspaceRoot}/packages/catalog/package.json",
          "{workspaceRoot}/packages/catalog/src/index.ts",
          "{workspaceRoot}/packages/emitter/package.json",
          "{workspaceRoot}/packages/emitter/src/index.ts",
          "{workspaceRoot}/packages/adapter-a2ui/package.json",
          "{workspaceRoot}/packages/adapter-a2ui/src/index.ts",
          "{workspaceRoot}/packages/adapter-mcp-apps/package.json",
          "{workspaceRoot}/packages/adapter-mcp-apps/src/index.ts",
          "{workspaceRoot}/scripts/lib/**/*",
          "{workspaceRoot}/scripts/gates/check-component-inventory.mjs"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/icons",
          "{projectRoot}/generated",
          "{projectRoot}/loader",
          "{projectRoot}/llms.txt",
          "{projectRoot}/llms-full.txt",
          "{projectRoot}/llms",
          "{projectRoot}/src/components.d.ts",
          "{workspaceRoot}/llms.txt",
          "{workspaceRoot}/llms-full.txt",
          "{workspaceRoot}/llms",
          "{workspaceRoot}/packages/react/src",
          "{workspaceRoot}/packages/vue/src",
          "{workspaceRoot}/packages/angular/src/directives"
        ]
      },
      "storybook": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "build-storybook": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  },
  "dependencies": {
    "@stencil/core": "4.45.3"
  },
  "devDependencies": {
    "@kimen/tokens": "workspace:*",
    "@size-limit/preset-small-lib": "14.3.0",
    "@stencil/angular-output-target": "1.6.0",
    "@stencil/react-output-target": "1.8.1",
    "@stencil/storybook-plugin": "0.7.1",
    "@stencil/vitest": "1.16.2",
    "@stencil/vue-output-target": "0.15.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@vitest/browser-playwright": "5.1.0",
    "axe-core": "4.14.0",
    "jsqr": "1.4.0",
    "playwright": "1.65.0",
    "size-limit": "14.3.0",
    "storybook": "10.6.7",
    "vitest": "5.1.0"
  },
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "customElements": "generated/custom-elements.json",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/kimen/kimen.esm.js",
  "sideEffects": [
    "./icons/*.js",
    "./dist/components/glyph-*.js",
    "./dist/esm/glyph-*.js",
    "./dist/cjs/glyph-*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js"
    },
    "./ki-*": {
      "types": "./dist/components/ki-*.d.ts",
      "import": "./dist/components/ki-*.js"
    },
    "./icons/*": {
      "types": "./icons/*.d.ts",
      "import": "./icons/*.js"
    },
    "./components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  }
}
