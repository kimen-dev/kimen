{
  "name": "@kimen/elements",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kimen web components (ki-*). Standards-first Stencil components, tokens-only styling, agent-legible by contract.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimen-dev/kimen.git",
    "directory": "packages/elements"
  },
  "files": [
    "dist",
    "loader",
    "generated/custom-elements.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "stencil build && node scripts/normalize-angular-proxies.mjs && node scripts/sync-components.mjs && node scripts/build-surfaces.mjs",
    "test": "vitest run && vitest run --config vitest.node.config.ts",
    "test-browser": "vitest run --config vitest.browser.config.ts",
    "test:coverage": "vitest run --coverage && vitest run --coverage --config vitest.browser.config.ts",
    "size": "node scripts/run-size-limit.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "nx": {
    "tags": [
      "scope:elements"
    ],
    "implicitDependencies": [
      "@kimen/tokens"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "^default",
          "!{projectRoot}/generated/**",
          "!{projectRoot}/loader/**",
          "!{projectRoot}/llms.txt"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/generated",
          "{projectRoot}/loader",
          "{projectRoot}/llms.txt",
          "{workspaceRoot}/llms.txt",
          "{workspaceRoot}/packages/react/src",
          "{workspaceRoot}/packages/vue/src",
          "{workspaceRoot}/packages/angular/src/directives"
        ]
      },
      "storybook": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "build-storybook": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  },
  "dependencies": {
    "@stencil/core": "4.43.5"
  },
  "devDependencies": {
    "@kimen/tokens": "workspace:*",
    "@size-limit/preset-small-lib": "13.0.3",
    "@stencil/angular-output-target": "1.4.1",
    "@stencil/react-output-target": "1.6.2",
    "@stencil/storybook-plugin": "0.7.0",
    "@stencil/vitest": "1.14.0",
    "@stencil/vue-output-target": "0.14.1",
    "@storybook/addon-a11y": "10.5.8",
    "@storybook/addon-docs": "10.5.8",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "4.13.0",
    "jsqr": "1.4.0",
    "playwright": "1.62.1",
    "size-limit": "13.0.3",
    "storybook": "10.5.8",
    "vitest": "4.1.10"
  },
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "customElements": "generated/custom-elements.json",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/kimen/kimen.esm.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js"
    },
    "./ki-*": {
      "types": "./dist/components/ki-*.d.ts",
      "import": "./dist/components/ki-*.js"
    },
    "./components": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    }
  }
}
