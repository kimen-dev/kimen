{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "importHelpers": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "types": []
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "//": "strictTemplates stays off: the value-accessor host bindings are machine-generated ($event.target?.['value']) and typed against EventTarget; template type-checking a generated string binding adds no safety and rejects the official output-target shape.",
    "strictTemplates": false
  },
  "include": ["src/**/*.ts"]
}
