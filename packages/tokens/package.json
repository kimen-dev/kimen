{
  "name": "@kimen/tokens",
  "version": "0.6.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Kimen design tokens (DTCG) compiled to CSS custom properties. Primitive \u2192 theme \u2192 semantic layers; onmars is the default theme (light + dark).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimen-dev/kimen.git",
    "directory": "packages/tokens"
  },
  "files": [
    "css",
    "dist",
    "fonts",
    "NOTICE"
  ],
  "exports": {
    "./css": "./dist/css/tokens.css",
    "./css/base": "./dist/css/base.css",
    "./css/core": "./dist/css/core.css",
    "./css/ki-*": "./dist/css/ki-*.css",
    "./css/material3": "./dist/css/tokens.material3.css",
    "./css/material3-fonts.css": "./css/material3-fonts.css",
    "./css/onmars-fonts.css": "./css/onmars-fonts.css"
  },
  "sideEffects": [
    "./css/*.css",
    "./dist/css/*.css"
  ],
  "scripts": {
    "build": "node ./build.mjs && pnpm run reference",
    "contrast": "node ./scripts/check-contrast.mjs",
    "reference": "node ./scripts/generate-reference.mjs",
    "size": "size-limit",
    "test": "node --test scripts/*.test.mjs"
  },
  "nx": {
    "tags": [
      "scope:tokens"
    ],
    "targets": {
      "size": {
        "inputs": [
          "default",
          "^default",
          "componentBudget"
        ]
      },
      "build": {
        "outputs": [
          "{projectRoot}/dist",
          "{workspaceRoot}/packages/elements/docs/tokens-reference.mdx"
        ],
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/packages/elements/src/components/**/*",
          "{workspaceRoot}/packages/elements/src/utils/**/*.css",
          "{workspaceRoot}/scripts/lib/component-token-usage.mjs",
          "{workspaceRoot}/scripts/lib/token-inventory.mjs"
        ]
      }
    }
  },
  "devDependencies": {
    "@size-limit/esbuild": "14.3.0",
    "@size-limit/file": "14.3.0",
    "size-limit": "14.3.0"
  }
}
