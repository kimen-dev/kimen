{
  "name": "@kimen/tokens",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Kimen design tokens (DTCG) compiled to CSS custom properties. Primitive \u2192 theme \u2192 semantic layers; onmars is the default theme (light + dark).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimen-dev/kimen.git",
    "directory": "packages/tokens"
  },
  "files": [
    "css",
    "dist",
    "fonts",
    "NOTICE"
  ],
  "exports": {
    "./css": "./dist/css/tokens.css",
    "./css/base": "./dist/css/base.css",
    "./css/material3": "./dist/css/tokens.material3.css",
    "./css/material3-fonts.css": "./css/material3-fonts.css",
    "./css/onmars-fonts.css": "./css/onmars-fonts.css"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "contrast": "node ./scripts/check-contrast.mjs",
    "reference": "node ./scripts/generate-reference.mjs",
    "size": "size-limit",
    "test": "node --test scripts/*.test.mjs"
  },
  "size-limit": [
    {
      "name": "onmars tokens stylesheet",
      "path": "dist/css/tokens.css",
      "limit": "12 KB"
    },
    {
      "name": "material3 tokens stylesheet",
      "path": "dist/css/tokens.material3.css",
      "limit": "5 KB"
    },
    {
      "name": "page contract stylesheet",
      "path": "dist/css/base.css",
      "limit": "250 B"
    }
  ],
  "nx": {
    "tags": [
      "scope:tokens"
    ]
  },
  "devDependencies": {
    "@size-limit/esbuild": "14.3.0",
    "@size-limit/file": "14.3.0",
    "size-limit": "14.3.0"
  }
}
