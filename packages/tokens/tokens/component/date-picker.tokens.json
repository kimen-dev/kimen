        "$description": "Optional image layered over the calendar fill."
      },
      "backdrop-filter": {
        "$value": "{ki.effect.no-backdrop-filter}",
        "$description": "Complete filter behind the calendar."
      },
      "border": {
        "$value": "{ki.outline.low-em}",
        "$description": "Calendar surface edge."
      },
      "shadow": {
        "$value": "{ki.elevation.e3}",
