      },
      "radius": {
        "$value": "{ki.corner.calendar-surface}",
        "$description": "Calendar popup corner radius."
      },
      "day-size": {
        "$value": "{ki.control.size.md}",
        "$description": "Default size of a day target."
      },
      "day-radius": {
        "$value": "{ki.control.radius.item}",
        "$description": "Radius of a day and the ends of a range."
      },
      "selected-bg": {
        "$value": "{ki.surface.primary-med-em}",
