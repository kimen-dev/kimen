      },
      "fab-gap": {
        "$type": "dimension",
        "$value": "{ki.layout.spacing.md}",
        "$description": "Gap between a floating pill and its companion FAB."
      },
      "docked-radius": {
        "$type": "dimension",
        "$value": "{ki.layout.spacing.zero}",
