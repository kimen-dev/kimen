        "$description": "Inline insets for docked actions."
      },
      "scroll-duration": {
        "$type": "duration",
        "$value": "{ki.motion.duration.medium-1}",
        "$description": "Duration of the scroll visibility transition."
      },
      "scroll-easing": {
        "$type": "cubicBezier",
        "$value": "{ki.motion.easing.standard}",
        "$description": "Easing of the scroll visibility transition."
      }
