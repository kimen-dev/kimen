{
  "ki": {
    "copy-button": {
      "$type": "color",
      "success-bg": {
        "$value": "{ki.surface.success-low-em}",
        "$description": "Contrast ground for the success glyph on filled primary copy buttons."
      },
      "success-fg": {
        "$value": "{ki.text.success-high-em}",
        "$description": "Confirmation check ink."
      },
      "error-bg": {
        "$value": "{ki.surface.danger-low-em}",
        "$description": "Contrast ground for the error glyph on filled primary copy buttons."
      },
      "error-fg": {
        "$value": "{ki.text.danger-high-em}",
        "$description": "Copy failure glyph ink."
      }
    }
  }
}
