{
  "name": "@kimen/adapter-mcp-apps",
  "version": "0.4.0",
  "private": false,
  "license": "Apache-2.0",
  "description": "Kimen adapter for MCP Apps (SEP-1865): disposable by design (constitution Art. VIII). Exposes Kimen surfaces to MCP Apps hosts as predeclared, self-contained ui:// resources rendered only through the guarded renderer. Supported protocol versions live in COMPAT.md, versioned with the adapter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimen-dev/kimen.git",
    "directory": "packages/adapter-mcp-apps"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./profiles/data": {
      "types": "./dist/generated/surface-profile-data.d.ts",
      "import": "./dist/generated/surface-profile-data.js"
    },
    "./profiles/form": {
      "types": "./dist/generated/surface-profile-form.d.ts",
      "import": "./dist/generated/surface-profile-form.js"
    }
  },
  "scripts": {
    "build": "node scripts/generate-surface.mjs && tsc -b --pretty false && tsc -p surface/tsconfig.json --pretty false && node ../../scripts/lib/generated-source-maps.mjs",
    "test": "vitest run",
    "test-browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@kimen/catalog": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.1",
    "esbuild": "0.28.2",
    "fast-check": "4.10.3",
    "happy-dom": "21.0.4",
    "playwright": "1.65.1",
    "vitest": "5.1.1",
    "zod": "4.6.7"
  },
  "nx": {
    "tags": [
      "scope:adapter"
    ],
    "implicitDependencies": [
      "@kimen/elements",
      "@kimen/tokens"
    ],
    "targets": {
      "test": {
        "inputs": [
          "default",
          "^default",
          "componentBudget"
        ]
      },
      "build": {
        "dependsOn": [
          "^build",
          {
            "projects": [
              "@kimen/catalog"
            ],
            "target": "build"
          }
        ],
        "inputs": [
          "{projectRoot}/**/*",
          "!{projectRoot}/src/generated/**",
          "{workspaceRoot}/scripts/lib/bundled-package-inventory.mjs",
          "{workspaceRoot}/scripts/lib/stock-surface-icons.mjs",
          "{workspaceRoot}/scripts/lib/generated-source-maps.mjs",
          "{workspaceRoot}/scripts/lib/package-contents.mjs",
          "^default"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/tsconfig.tsbuildinfo",
          "{projectRoot}/src/generated"
        ]
      }
    }
  }
}
