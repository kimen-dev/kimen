{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "useInferencePlugins": false,
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true,
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "lint": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "cache": true
    },
    "test-browser": {
      "dependsOn": [
        "build"
      ],
      "cache": true
    },
    "size": {
      "dependsOn": [
        "build"
      ],
      "cache": true
    }
  },
  "release": {
    "projects": [
      "@kimen/elements",
      "@kimen/tokens",
      "@kimen/mcp-server",
      "@kimen/catalog",
      "@kimen/emitter",
      "@kimen/adapter-a2ui",
      "@kimen/adapter-mcp-apps",
      "@kimen/react",
      "@kimen/vue",
      "@kimen/angular"
    ],
    "projectsRelationship": "fixed",
    "conventionalCommits": {
      "useCommitScope": false
    },
    "releaseTag": {
      "pattern": "v{version}",
      "checkAllBranchesWhen": false
    },
    "version": {
      "conventionalCommits": true,
      "adjustSemverBumpsForZeroMajorVersion": false,
      "updateDependents": "never",
      "preserveLocalDependencyProtocols": true,
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "file": "CHANGELOG.md",
        "createRelease": false,
        "renderOptions": {
          "authors": false
        }
      }
    }
  },
  "namedInputs": {
    "componentBudget": [
      "{workspaceRoot}/scripts/lib/bundle-size-budget.mjs",
      "{workspaceRoot}/packages/elements/scripts/component-metadata.mjs",
      "{workspaceRoot}/packages/elements/src/components/*/component.json"
    ],
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/biome.json"
    ]
  },
  "analytics": false,
  "affected": {
    "legacy": true
  }
}
