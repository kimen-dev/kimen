---
const docsBase = `${import.meta.env.BASE_URL.replace(/\/$/u, '')}/`;
const siteBase = docsBase.replace(/docs\/?$/u, '');
---

<ul class="kimen-sidebar-sites" aria-label="Kimen site">
  <li><a href={siteBase}>Home</a></li>
  <li><a href={`${siteBase}playground/`}>Playground</a></li>
  <li><a href="https://github.com/kimen-dev/kimen">GitHub</a></li>
</ul>
