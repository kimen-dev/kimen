---
import manifest from '../../../../packages/elements/generated/custom-elements.json';
import { getCollection } from 'astro:content';
import { groupByFamily } from '../../component-families.mjs';

const docsBase = `${import.meta.env.BASE_URL.replace(/\/$/u, '')}/`;
const descriptions = new Map(
  manifest.modules.flatMap(({ declarations }) =>
    declarations.map(({ tagName, description }) => [tagName, description]),
  ),
);

// Short standalone specimens supplement the generated directory. The
// documentation page remains the source for multi-state and composed demos.
const previews = new Map([
  ['ki-button', '<ki-button variant="primary">Save</ki-button>'],
  ['ki-input', '<ki-input label="Workspace" value="Atlas research"></ki-input>'],
  ['ki-textarea', '<ki-textarea label="Notes" rows="2" value="Review the outline"></ki-textarea>'],
  [
    'ki-select',
    '<ki-select label="Region" value="eu-west"><ki-option value="eu-west">eu-west</ki-option><ki-option value="us-east">us-east</ki-option></ki-select>',
  ],
  ['ki-checkbox', '<ki-checkbox checked>Weekly digest</ki-checkbox>'],
  [
    'ki-radio-group',
    '<ki-radio-group label="Plan" value="team"><ki-radio value="solo">Solo</ki-radio><ki-radio value="team">Team</ki-radio></ki-radio-group>',
  ],
  ['ki-switch', '<ki-switch checked>Invite via link</ki-switch>'],
  ['ki-alert', '<ki-alert tone="success" heading="Saved">Draft stored.</ki-alert>'],
  ['ki-progress', '<ki-progress label="Storage" value="64"></ki-progress>'],
  [
    'ki-status',
    '<span class="kimen-index-row"><ki-status tone="success" label="Online"></ki-status> API gateway</span>',
  ],
  ['ki-indicator', '<ki-indicator count="5" current="2" label="Gallery page"></ki-indicator>'],
  ['ki-card', '<ki-card><span slot="header">Workspace</span>3 members · eu-west</ki-card>'],
  [
    'ki-list',
    '<ki-list aria-label="Members"><ki-list-item>Ana García</ki-list-item><ki-list-item>Mina Kato</ki-list-item></ki-list>',
  ],
  ['ki-avatar', '<ki-avatar initials="AG" label="Ana García"></ki-avatar>'],
  [
    'ki-avatar-group',
    '<ki-avatar-group><ki-avatar initials="AG" label="Ana García"></ki-avatar><ki-avatar initials="MK" label="Mina Kato"></ki-avatar><ki-avatar initials="LB" label="Leo Brandt"></ki-avatar></ki-avatar-group>',
  ],
  [
    'ki-badge',
    '<span class="kimen-index-row"><ki-badge tone="success">Synced</ki-badge><ki-badge>eu-west</ki-badge></span>',
  ],
  ['ki-divider', '<span class="kimen-index-stack">Above<ki-divider></ki-divider>Below</span>'],
  ['ki-qr', '<ki-qr value="https://kimen.dev/" label="Open kimen.dev"></ki-qr>'],
  [
    'ki-tabs',
    '<ki-tabs label="Settings" value="email"><ki-tab value="email">Email</ki-tab><ki-tab value="security">Security</ki-tab><ki-tab-panel value="email">Email preferences</ki-tab-panel><ki-tab-panel value="security">Sign-in preferences</ki-tab-panel></ki-tabs>',
  ],
]);
const docs = await getCollection(
  'docs',
  ({ id, data }) => id.startsWith('components/') && !data.draft,
);

// The page's own short description leads; the manifest's (the full JSDoc, in
// Markdown) is only a fallback, with its inline code kept as code.
const escapeHtml = (text: string) =>
  text.replace(/[&<>"']/gu, (character) => `&#${character.charCodeAt(0)};`);
const inlineCode = (markdown: string) =>
  escapeHtml(markdown).replace(/`([^`]+)`/gu, '<code>$1</code>');

const entriesById = new Map(
  docs.map(({ id, data }) => {
    const tag = `ki-${id.slice('components/'.length)}`;
    return [
      id,
      {
        path: id,
        tag,
        description: inlineCode(data.description || (descriptions.get(tag) ?? '')),
        preview: previews.get(tag),
      },
    ];
  }),
);
// Grouped by family (component-families.mjs, as in the sidebar), then by
// name. A live preview is an extra on its card, never a sort key.
const families = groupByFamily(entriesById.keys()).map(([label, ids]) => ({
  label,
  id: `docs-components-${label.toLowerCase()}`,
  entries: ids.map((id) => entriesById.get(id)!),
}));
---

<section aria-labelledby="docs-components-title">
  <h2 id="docs-components-title">Components</h2>
  <p class="kimen-home-index-lede">Try a component or open its documentation for examples and the API.</p>
  {
    families.map(({ label, id, entries }) => (
      <section class="kimen-index-family" aria-labelledby={id}>
        <h3 id={id}>{label}</h3>
        <ul class="kimen-index">
          {entries.map(({ path, tag, description, preview }) => (
            <li class="kimen-index-cell">
              {preview && <div class="kimen-index-sample" data-pagefind-ignore set:html={preview} />}
              <a class="kimen-index-name" href={`${docsBase}${path}/`}>{tag}</a>
              <p class="kimen-index-desc" set:html={description} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</section>

<script>
  import { defineAllComponents } from 'virtual:kimen-component-registrations';

  defineAllComponents();
</script>
