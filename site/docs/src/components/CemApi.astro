---
// Static API reference rendered at build time from the generated Custom
// Elements Manifest of @kimen/elements (constitution Art. I: API facts are
// never hand-written — this component is the only way component API tables
// appear on the site). Zero client JavaScript; fully indexed by Pagefind.
import manifest from '../../../../packages/elements/generated/custom-elements.json';

interface Props {
  /** Custom element tag name, e.g. "ki-button". */
  tag: string;
}

const { tag } = Astro.props;

type CemType = { text?: string } | undefined;
interface CemMember {
  kind: string;
  name: string;
  privacy?: string;
  type?: CemType;
  default?: string;
  description?: string;
  attribute?: string;
  reflects?: boolean;
  signature?: string;
  return?: { type?: CemType };
}
interface CssProperty {
  name: string;
  description?: string;
  default?: string;
  material3Default?: string;
}
interface TokenState {
  variant: string | null;
  tone: string | null;
  state: string;
  tokens: string[];
}
interface CemDeclaration {
  tagName?: string;
  description?: string;
  whenToUse?: string;
  whenNotToUse?: string;
  attributes?: Array<{
    name: string;
    fieldName?: string;
    type?: CemType;
    default?: string;
    description?: string;
  }>;
  members?: CemMember[];
  events?: Array<{ name: string; type?: CemType; description?: string }>;
  slots?: Array<{ name: string; description?: string }>;
  cssParts?: Array<{ name: string; description?: string }>;
  cssProperties?: CssProperty[];
  tokenStates?: TokenState[];
  cssStates?: Array<{ name: string; description?: string }>;
}

const declarations: CemDeclaration[] = (
  manifest as { modules: Array<{ declarations?: CemDeclaration[] }> }
).modules.flatMap((m) => m.declarations ?? []);
const decl = declarations.find((d) => d.tagName === tag);
if (!decl) {
  throw new Error(`CemApi: tag "${tag}" not found in custom-elements.json`);
}

const escapeHtml = (value: string): string =>
  value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');

/** Escape, then render `inline code` spans; collapse newlines to spaces. */
const md = (value: string | undefined): string =>
  escapeHtml(value ?? '')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replaceAll('\n', ' ');

const code = (value: string | undefined): string =>
  value ? `<code>${escapeHtml(value)}</code>` : '–';

const attributes = decl.attributes ?? [];
const methods = (decl.members ?? []).filter((m) => m.kind === 'method' && m.privacy !== 'private');
const events = decl.events ?? [];
const slots = decl.slots ?? [];
const parts = decl.cssParts ?? [];
const cssProperties = decl.cssProperties ?? [];
const tokenByName = new Map(cssProperties.map((property) => [property.name, property]));
const tokenGroups = decl.tokenStates ?? [];
const groupedTokens = new Set(tokenGroups.flatMap(({ tokens }) => tokens));
const tokenTables = [
  {
    id: `${tag}-state-tokens`,
    title: 'CSS custom properties by variant and state',
    grouped: true,
    rows: tokenGroups.flatMap(({ variant, tone, state, tokens }) =>
      tokens.map((name) => {
        const property = tokenByName.get(name);
        if (!property) throw new Error(`CemApi: ${tag} has no CSS property ${name}`);
        return { property, variant, tone, state };
      }),
    ),
  },
  {
    id: `${tag}-css-properties`,
    title: tokenGroups.length > 0 ? 'Other CSS custom properties' : 'CSS custom properties',
    grouped: false,
    rows: cssProperties
      .filter(({ name }) => !groupedTokens.has(name))
      .map((property) => ({
        property,
        variant: null,
        tone: null,
        state: null,
      })),
  },
];
const states = decl.cssStates ?? [];
---

<section class="cem-api" data-pagefind-body>
  {
    decl.whenToUse && (
      <p>
        <strong>When to use:</strong> <Fragment set:html={md(decl.whenToUse)} />
      </p>
    )
  }
  {
    decl.whenNotToUse && (
      <p>
        <strong>When not to use:</strong> <Fragment set:html={md(decl.whenNotToUse)} />
      </p>
    )
  }

  <h3 id={`${tag}-token-stylesheets`}>Token stylesheets</h3>
  <p>
    Load <code>@kimen/tokens/css/core</code> once per page and
    <code>{`@kimen/tokens/css/${tag}`}</code> for this component: only the tokens it needs,
    including those of the components it renders. Load the sheet of every <code>ki-*</code> tag
    the page uses. The simple alternative is <code>@kimen/tokens/css</code> once per page instead:
    every token in one sheet.
  </p>

  {
    attributes.length > 0 && (
      <>
        <h3 id={`${tag}-properties`}>Properties &amp; attributes</h3>
        <div
          class="cem-table"
          role="region"
          aria-labelledby={`${tag}-properties`}
          tabindex="0"
        >
          <table>
            <thead>
              <tr>
                <th>Attribute</th>
                <th>Property</th>
                <th>Type</th>
                <th>Default</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {attributes.map((a) => (
                <tr>
                  <td>
                    <code>{a.name}</code>
                  </td>
                  <td>
                    <code>{a.fieldName ?? a.name}</code>
                  </td>
                  <td set:html={code(a.type?.text)} />
                  <td set:html={code(a.default)} />
                  <td set:html={md(a.description)} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  {
    events.length > 0 && (
      <>
        <h3 id={`${tag}-events`}>Events</h3>
        <div
          class="cem-table"
          role="region"
          aria-labelledby={`${tag}-events`}
          tabindex="0"
        >
          <table>
            <thead>
              <tr>
                <th>Event</th>
                <th>Detail type</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {events.map((e) => (
                <tr>
                  <td>
                    <code>{e.name}</code>
                  </td>
                  <td set:html={code(e.type?.text)} />
                  <td set:html={md(e.description)} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  {
    methods.length > 0 && (
      <>
        <h3 id={`${tag}-methods`}>Methods</h3>
        <div
          class="cem-table"
          role="region"
          aria-labelledby={`${tag}-methods`}
          tabindex="0"
        >
          <table>
            <thead>
              <tr>
                <th>Method</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {methods.map((m) => (
                <tr>
                  <td set:html={code(m.signature ?? m.name)} />
                  <td set:html={md(m.description)} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  {
    slots.length > 0 && (
      <>
        <h3 id={`${tag}-slots`}>Slots</h3>
        <div
          class="cem-table"
          role="region"
          aria-labelledby={`${tag}-slots`}
          tabindex="0"
        >
          <table>
            <thead>
              <tr>
                <th>Slot</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {slots.map((s) => (
                <tr>
                  <td>{s.name ? <code>{s.name}</code> : <em>(default)</em>}</td>
                  <td set:html={md(s.description)} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  {
    parts.length > 0 && (
      <>
        <h3 id={`${tag}-css-parts`}>CSS parts</h3>
        <div
          class="cem-table"
          role="region"
          aria-labelledby={`${tag}-css-parts`}
          tabindex="0"
        >
          <table>
            <thead>
              <tr>
                <th>Part</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {parts.map((p) => (
                <tr>
                  <td>
                    <code>{p.name}</code>
                  </td>
                  <td set:html={md(p.description)} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  {
    tokenTables
      .filter(({ rows }) => rows.length > 0)
      .map(({ id, title, grouped, rows }) => (
          <>
            <h3 id={id}>{title}</h3>
            <div class="cem-table" role="region" aria-labelledby={id} tabindex="0">
              <table>
                <thead>
                  <tr>
                    {grouped && (
                      <>
                        <th scope="col">Variant</th>
                        <th scope="col">Tone</th>
                        <th scope="col">State</th>
                      </>
                    )}
                    <th scope="col">Token</th>
                    <th scope="col">Default</th>
                    <th scope="col">Description</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map(({ property, variant, tone, state }) => (
                    <tr>
                      {grouped && (
                        <>
                          <td>{variant ?? '—'}</td>
                          <td>{tone ?? '—'}</td>
                          <td>{state}</td>
                        </>
                      )}
                      <td><code>{property.name}</code></td>
                      <td>
                        {property.material3Default !== undefined ? (
                          <>
                            onmars <code>{property.default}</code>
                            <br />
                            material3 <code>{property.material3Default}</code>
                          </>
                        ) : (
                          <code>{property.default}</code>
                        )}
                      </td>
                      <td set:html={md(property.description)} />
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
      ))
  }

  {
    states.length > 0 && (
      <>
        <h3 id={`${tag}-custom-states`}>Custom states</h3>
        <div
          class="cem-table"
          role="region"
          aria-labelledby={`${tag}-custom-states`}
          tabindex="0"
        >
          <table>
            <thead>
              <tr>
                <th>State</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {states.map((s) => (
                <tr>
                  <td>
                    <code>{s.name}</code>
                  </td>
                  <td set:html={md(s.description)} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }
</section>
