---
import { Icon } from '@astrojs/starlight/components';
import Search from '@astrojs/starlight/components/Search.astro';

const docsBase = `${import.meta.env.BASE_URL.replace(/\/$/u, '')}/`;
const siteBase = docsBase.replace(/docs\/?$/u, '');
const { entry, hasSidebar } = Astro.locals.starlightRoute;
const guidePaths = ['guides/ui-spec', 'guides/emitting-specs', 'guides/a2ui', 'guides/mcp-apps'];
const isDocsHome = Astro.url.pathname.replace(/\/$/u, '') === docsBase.slice(0, -1);
const componentIndex = { href: docsBase, label: 'Components' };
const sections = [
  {
    label: 'Start',
    path: 'getting-started',
    current: isDocsHome || entry.id === 'getting-started',
  },
  {
    label: 'Guides',
    path: 'guides/theming',
    current: entry.id.startsWith('guides/') && !guidePaths.includes(entry.id),
  },
  { label: 'Generative UI', path: 'guides/ui-spec', current: guidePaths.includes(entry.id) },
  {
    ...componentIndex,
    path: '#docs-components-title',
    current: entry.id.startsWith('components/'),
  },
  { label: 'Tokens', path: 'tokens/reference', current: entry.id.startsWith('tokens/') },
  {
    label: 'Resources',
    path: 'resources/working-with-ai',
    current: entry.id.startsWith('resources/'),
  },
];
const siteLinks = [
  { href: siteBase, label: 'Home' },
  { href: `${siteBase}playground/`, label: 'Playground' },
];
const schemes = ['Auto', 'Light', 'Dark'] as const;
// The same icons as the shared control on the other site pages (site/segmented.css):
// below 50rem each option shows only its icon and keeps its name for assistive technology.
const schemeIcons: Record<(typeof schemes)[number], string> = {
  Auto: '<rect width="20" height="14" x="2" y="3" rx="2" /><path d="M8 21h8" /><path d="M12 17v4" />',
  Light:
    '<circle cx="12" cy="12" r="4" /><path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" /><path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />',
  Dark: '<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />',
};
---

<div class="kimen-docs-header">
  <a class="kimen-docs-identity" href={docsBase}>
    <svg class="kimen-docs-brand-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 3v18M4 12h4l7-9h5L12.5 12 20 21h-5l-7-9"></path>
    </svg>
    <span class="kimen-docs-site-title" translate="no">Kimen</span>
    <span class="kimen-docs-stage">pre-v1</span>
    <span class="visually-hidden">documentation home</span>
  </a>

  <nav class="kimen-docs-tabs" aria-label="Documentation sections">
    {
      sections.map((section) => (
        <a
          href={'href' in section ? `${section.href}${section.path}` : `${docsBase}${section.path}/`}
          aria-current={entry.id === section.path ? 'page' : section.current ? 'location' : undefined}
        >
          {section.label}
        </a>
      ))
    }
  </nav>

  <div class="kimen-docs-search"><Search /></div>

  <fieldset class="kimen-docs-scheme" data-docs-scheme-control>
    <legend class="visually-hidden">Color scheme</legend>
    {
      schemes.map((name) => (
        <label>
          <input type="radio" name="docs-scheme" value={name.toLowerCase()} checked={name === 'Auto'} />
          <span>
            <svg
              class="kimen-docs-scheme-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
              set:html={schemeIcons[name]}
            />
            <span class="kimen-docs-scheme-text">{name}</span>
          </span>
        </label>
      ))
    }
  </fieldset>

  <nav class="kimen-docs-primary-nav" aria-label="Site">
    {siteLinks.map(({ href, label }) => <a href={href}>{label}</a>)}
    <a class="kimen-docs-github" href="https://github.com/kimen-dev/kimen">
      <Icon name="github" />
      <span class="visually-hidden">GitHub</span>
    </a>
  </nav>

  {
    /* Below 50rem the section tabs and site links leave the header. Pages
       with a sidebar reach them through Starlight's menu button (the sidebar,
       then MobileMenuFooter); the docs home is a splash page with no sidebar,
       so it gets this disclosure instead. */
    !hasSidebar && (
      <details class="kimen-docs-menu" data-docs-menu>
        <summary>
          <Icon name="bars" class="kimen-docs-menu-open" />
          <Icon name="close" class="kimen-docs-menu-close" />
          <span class="visually-hidden">Menu</span>
        </summary>
        <div class="kimen-docs-menu-panel">
          <nav aria-label="Documentation sections">
            <ul>
              {sections.map((section) => (
                <li>
                  <a
                    href={'href' in section ? `${section.href}${section.path}` : `${docsBase}${section.path}/`}
                    aria-current={section.current ? 'location' : undefined}
                  >
                    {section.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <nav aria-label="Site">
            <ul>
              {siteLinks.map(({ href, label }) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
              <li>
                <a href="https://github.com/kimen-dev/kimen">GitHub</a>
              </li>
            </ul>
          </nav>
        </div>
      </details>
    )
  }
</div>

<script>
  type Scheme = 'auto' | 'light' | 'dark';

  const root = document.documentElement;
  const radios = document.querySelectorAll<HTMLInputElement>('[data-docs-scheme-control] input');
  const media = matchMedia('(prefers-color-scheme: light)');

  const isScheme = (value: unknown): value is Scheme =>
    value === 'auto' || value === 'light' || value === 'dark';

  function readScheme(): Scheme {
    try {
      const stored = localStorage.getItem('kimen-scheme');
      if (isScheme(stored)) return stored;
    } catch {
      // The inline provider still resolves the current page.
    }
    return 'auto';
  }

  function applyScheme(scheme: Scheme) {
    const resolved = scheme === 'auto' ? (media.matches ? 'light' : 'dark') : scheme;
    root.dataset.kimenScheme = scheme;
    root.dataset.theme = resolved;
    root.dataset.kiColorScheme = resolved;
    for (const radio of radios) radio.checked = radio.value === scheme;
  }

  function chooseScheme(event: Event) {
    const target = event.target;
    if (!(target instanceof HTMLInputElement)) return;
    const scheme = target.value;
    if (!isScheme(scheme)) return;
    applyScheme(scheme);
    try {
      localStorage.setItem('kimen-scheme', scheme);
    } catch {
      // Changing the scheme for the current page needs no storage.
    }
  }

  for (const radio of radios) radio.addEventListener('change', chooseScheme);
  media.addEventListener('change', () => {
    if (root.dataset.kimenScheme === 'auto') applyScheme('auto');
  });
  window.addEventListener('storage', ({ key }) => {
    if (key === 'kimen-scheme' || key === null) applyScheme(readScheme());
    if (key === 'kimen-theme' || key === null) applyTheme();
  });

  function applyTheme() {
    try {
      root.dataset.kiTheme = localStorage.getItem('kimen-theme') === 'material3' ? 'material3' : 'onmars';
    } catch {
      root.dataset.kiTheme = 'onmars';
    }
  }

  applyScheme(readScheme());

  // The docs-home menu is a native <details>; close it the way a menu closes:
  // on Escape (focus back on its button), on a click outside it, and when a
  // link inside it is followed (a same-page hash link would leave it open).
  const menu = document.querySelector<HTMLDetailsElement>('[data-docs-menu]');
  if (menu) {
    const summary = menu.querySelector('summary');
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      summary?.focus();
    });
    document.addEventListener('click', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });
  }
</script>
