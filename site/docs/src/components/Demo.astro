---
// The source snippet remains the single source for both the live example
// and its Expressive Code panel.
import { Code } from '@astrojs/starlight/components';

interface Props {
  code: string;
  lang?: string;
  layout?: 'row' | 'block';
  live?: boolean;
}

const { code, lang = 'html', layout = 'row', live = true } = Astro.props;
---

<figure class="ki-demo not-content">
  {
    live && (
      <form class="ki-demo-bar">
        <fieldset class="ki-demo-segment">
          <legend class="visually-hidden">Theme for this example</legend>
          <label><input type="radio" name="demo-theme" value="" data-demo-theme checked /><span>Page theme</span></label>
          <label><input type="radio" name="demo-theme" value="onmars" data-demo-theme /><span>Onmars</span></label>
          <label><input type="radio" name="demo-theme" value="material3" data-demo-theme /><span>Material 3</span></label>
        </fieldset>
        <fieldset class="ki-demo-segment">
          <legend class="visually-hidden">Color scheme for this example</legend>
          <label><input type="radio" name="demo-scheme" value="" data-demo-scheme checked /><span>Page scheme</span></label>
          <label><input type="radio" name="demo-scheme" value="light" data-demo-scheme /><span>Light</span></label>
          <label><input type="radio" name="demo-scheme" value="dark" data-demo-scheme /><span>Dark</span></label>
        </fieldset>
      </form>
      <div class:list={['ki-demo-surface', `ki-demo-${layout}`]} set:html={code} />
    )
  }
  <div class="ki-demo-code"><Code code={code} lang={lang} /></div>
</figure>

<script>
  import { defineAllComponents } from 'virtual:kimen-component-registrations';

  defineAllComponents();

  for (const demo of document.querySelectorAll<HTMLElement>('.ki-demo')) {
    const surface = demo.querySelector('.ki-demo-surface');
    demo.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) || !target.checked || !surface) return;
      const attribute = target.hasAttribute('data-demo-theme') ? 'data-ki-theme'
        : target.hasAttribute('data-demo-scheme') ? 'data-ki-color-scheme' : null;
      if (!attribute) return;
      if (target.value) surface.setAttribute(attribute, target.value);
      else surface.removeAttribute(attribute);
    });
  }
</script>
