---
// Keep the privacy declaration reachable from every documentation page.
import Default from '@astrojs/starlight/components/Footer.astro';

const docsBase = `${import.meta.env.BASE_URL.replace(/\/$/u, '')}/`;
const siteBase = docsBase.replace(/docs\/?$/u, '');
---

<Default><slot /></Default>

<nav class="kimen-docs-legal" aria-label="Footer">
  <a class="kimen-docs-footer-site" href={siteBase}>Home</a>
  <a class="kimen-docs-footer-site" href={`${siteBase}playground/`}>Playground</a>
  <a href={`${siteBase}privacy/`}>Privacy</a>
</nav>

<style>
  .kimen-docs-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--ki-space-xl);
    margin-block-start: var(--ki-space-5xl);
    font-size: var(--ki-typography-size-body-1);
    color: var(--ki-text-med-em);
    text-align: center;
  }

  .kimen-docs-legal a {
    color: inherit;
  }

  @media (width >= 90rem) {
    .kimen-docs-footer-site {
      display: none;
    }
  }

  .kimen-docs-legal a:hover {
    color: var(--ki-text-high-em);
  }
</style>
