{/* Resolve the shared Kimen preferences before the browser paints the docs. */}
<script is:inline>
  (() => {
    const root = document.documentElement;
    let storedScheme = null;
    let storedTheme = null;
    try {
      storedScheme = localStorage.getItem('kimen-scheme');
      storedTheme = localStorage.getItem('kimen-theme');
    } catch {
      // Browsing contexts can disable storage.
    }
    const validScheme = storedScheme === 'auto' || storedScheme === 'light' || storedScheme === 'dark';
    const preference = validScheme ? storedScheme : 'auto';
    const resolved = preference === 'auto'
      ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
      : preference;

    root.dataset.kimenScheme = preference;
    root.dataset.theme = resolved;
    root.dataset.kiColorScheme = resolved;
    root.dataset.kiTheme = storedTheme === 'material3' ? 'material3' : 'onmars';
  })();
</script>
