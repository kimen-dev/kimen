<%= specMarker %>
import tokensCss from '@kimen/tokens/css?raw';
import { afterAll, afterEach, beforeAll, expect, it } from 'vitest';
import { page } from 'vitest/browser';

import { expectAccessible } from '../../../browser-tests/axe';
import { defineCustomElement } from '../../../dist/components/<%= name %>.js';

const styles = document.createElement('style');
const fixture = document.createElement('main');

beforeAll(() => {
  defineCustomElement();
  styles.textContent = tokensCss;
  document.head.appendChild(styles);
  document.body.appendChild(fixture);
});

afterEach(() => fixture.replaceChildren());
afterAll(() => {
  fixture.remove();
  styles.remove();
});

it('S1: renders the consumer-supplied label', async () => {
  // TODO(spec): replace this scaffold assertion with the approved core scenario.
  const element = document.createElement('<%= name %>');
  element.setAttribute('label', 'Example');
  fixture.appendChild(element);
  await expect.element(page.getByText('Example')).toBeVisible();
  await expectAccessible(fixture);
});

