/* Tokens only (Art. VI): every visual value resolves from a --ki-* token.
 * Logical properties only (Art. IV): direction-agnostic by construction. */
:host {
  display: block;
}

/* The HTML hidden attribute outranks the host's own display. */
:host([hidden]) {
  display: none;
}

.label {
  color: var(--ki-<%= tokenName %>-text-color);
  font-family: var(--ki-typography-family-base);
  font-size: var(--ki-typography-size-body);
}
