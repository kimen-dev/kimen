{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "**/dist/**",
    "**/generated/**",
    ".specify/**",
    ".claude/**",
    "packages/react/src/components.ts",
    "packages/react/src/ki-*.ts",
    "packages/react/tests/fixtures/**",
    "packages/vue/src/index.ts",
    "packages/vue/src/ki-*.ts",
    "packages/angular/src/directives/**"
  ],
  "ignoreDependencies": ["husky", "nx", "@kimen/nx-plugin", "@stencil/vitest"],
  "ignoreIssues": {
    "scripts/mutation-tests/react-runtime.spec.mjs": ["unlisted"],
    "scripts/mutation-tests/react-runtime-ssr.spec.mjs": ["unlisted"]
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs", "*.config.{ts,mjs}"],
      "project": ["scripts/**/*.mjs", "*.config.{ts,mjs}"],
      "ignoreDependencies": ["@arethetypeswrong/cli", "@stryker-mutator/vitest-runner", "publint"],
      "stencil": false
    },
    "packages/*": {
      "entry": ["src/index.ts", "*.config.{ts,mjs}", "size-limit/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx,mjs}", "!**/*.d.ts"],
      "stencil": false
    },
    "packages/adapter-mcp-apps": {
      "entry": [
        "src/index.ts",
        "surface/surface-runtime.ts",
        "scripts/generate-surface.mjs",
        "*.config.{ts,mjs}"
      ],
      "project": ["**/*.{ts,tsx,mjs}", "!**/*.d.ts"],
      "stencil": false
    },
    "packages/mcp-server": {
      "entry": ["src/main.ts", "scripts/build.mjs", "*.config.{ts,mjs}"],
      "project": ["**/*.{ts,mjs}", "!**/*.d.ts"],
      "stencil": false
    },
    "packages/elements": {
      "entry": [
        "src/index.ts",
        "src/components/*/*.tsx",
        "!src/components/*/*.stories.tsx",
        "src/components/ki-*/gallery.ts",
        "*.config.{ts,mjs}",
        "size-limit/**/*.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx,mjs}", "!**/*.d.ts"],
      "stencil": false
    },
    "site/docs": {
      "entry": ["src/components/IconDemo.astro"],
      "ignoreDependencies": ["@kimen/elements"]
    },
    "packages/kimen": {
      "entry": ["index.mjs"],
      "project": ["**/*.mjs"]
    },
    "tools/*": {
      "entry": ["src/generators/*/generator.js"],
      "project": ["**/*.js"]
    }
  }
}
